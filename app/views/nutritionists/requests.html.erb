<% content_for :title, "Pending Requests - #{@nutritionist.name}" %>

<div class="container">
  <%= link_to "← Back to Search", nutritionists_path, class: "btn btn-secondary", style: "margin-bottom: 1.5rem;" %>

  <header class="header">
    <h1>Pending Appointment Requests</h1>
    <p><%= @nutritionist.name %> — <%= @nutritionist.location %></p>
  </header>

  <div id="nutritionist-requests-app"
       data-nutritionist-id="<%= @nutritionist.id %>"
       data-api-url="<%= api_nutritionist_appointment_requests_path(@nutritionist) %>">
    <div class="empty-state">
      <p>Loading requests...</p>
    </div>
  </div>
</div>

